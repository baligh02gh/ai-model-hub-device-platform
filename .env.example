# Copy to .env and replace every placeholder before running locally.
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=your_db_name
DATABASE_URL=postgresql://your_db_user:replace_with_a_strong_password@localhost:5432/your_db_name
SECRET_KEY=replace_with_python_secrets_token_hex_32
MQTT_USERNAME=trinovatech_backend
MQTT_PASSWORD=replace_with_a_strong_random_password
